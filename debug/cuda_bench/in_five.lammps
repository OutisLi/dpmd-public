# NVT throughput benchmark of a frozen DeePMD-kit model (.pt2) on five elements
# at random on the sites of the diamond benchmark (gen_system.write_five_data),
# more than the slotted scans of DPA4C serve; every other setting is that of
# in.lammps.
units           metal
boundary        p p p
atom_style      atomic
atom_modify     map yes         # required by the Kokkos deepmd/kk pair

read_data       ${datafile}

pair_style      deepmd ${model}
pair_coeff      * * B C N O F

neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

velocity        all create 300.0 12345 mom yes rot yes dist gaussian
fix             1 all nvt temp 300.0 300.0 0.1
timestep        0.001

thermo          ${nsteps}
run             ${warmup}       # warmup: AOTInductor first launch + neighbor build
run             ${nsteps}       # timed run (last timing breakdown is parsed)
