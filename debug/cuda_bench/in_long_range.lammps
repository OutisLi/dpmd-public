# NVT step of a frozen DeePMD-kit model (.pt2) on boron, carbon and nitrogen at
# random on the sites of the diamond benchmark (gen_system.write_bcn_data),
# periodic (boundary p p p) or as a shrink-wrapped cluster of the same atoms
# (s s s). With dump 1, the file dumpfile receives the positions and forces
# after the timed run, in full precision, for the reproducibility check.
units           metal
boundary        ${boundary}
atom_style      atomic
atom_modify     map yes         # required by the Kokkos deepmd/kk pair

read_data       ${datafile}

pair_style      deepmd ${model}
pair_coeff      * * B C N

neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

velocity        all create 300.0 12345 mom yes rot yes dist gaussian
fix             1 all nvt temp 300.0 300.0 0.1
timestep        0.001

variable        dump index 0
variable        dumpfile index none
thermo          ${nsteps}
run             ${warmup}       # warmup: AOTInductor first launch + neighbor build
run             ${nsteps}       # timed run (last timing breakdown is parsed)
if "${dump} == 1" then &
  "write_dump all custom ${dumpfile} id type x y z fx fy fz modify format float %.17g sort id"
