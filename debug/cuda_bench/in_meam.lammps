# Kokkos pure-carbon MEAM benchmark on a cached diamond system.
units           metal
boundary        p p p
atom_style      atomic
newton          on

read_data       ${datafile}

pair_style      meam
pair_coeff      * * /aisi-vepfs/outisli/Software/lammps/lammps-patch_4Jul2026/examples/meam/library.meam C NULL C

neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes
velocity        all create 300.0 12345 mom yes rot yes dist gaussian
fix             1 all nvt temp 300.0 300.0 0.1
timestep        0.001

thermo          ${nsteps}
run             ${warmup}
run             ${nsteps}
