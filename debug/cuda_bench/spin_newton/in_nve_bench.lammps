# NVE counterpart of debug/cuda_bench/in.lammps: the same system, pair style,
# neighbor settings and run protocol with fix nve instead of fix nvt.
units           metal
boundary        p p p
atom_style      atomic
atom_modify     map yes         # required by the Kokkos deepmd/kk pair

read_data       ${datafile}

pair_style      deepmd ${model}
pair_coeff      * * C

neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

velocity        all create 300.0 12345 mom yes rot yes dist gaussian
fix             1 all nve
timestep        0.001

thermo          ${nsteps}
run             ${warmup}       # warmup: AOTInductor first launch + neighbor build
run             ${nsteps}       # timed run (last timing breakdown is parsed)
