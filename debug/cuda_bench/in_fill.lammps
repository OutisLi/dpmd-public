# Per-atom energies and forces of one configuration under a chosen neighbor
# skin: the skin sets the candidate list length and so the fill of the compact
# canonical graph (single pass up to 512 candidates, team scratch beyond).
units           metal
boundary        p p p
atom_style      atomic
atom_modify     map yes
read_data       ${datafile}
pair_style      deepmd ${model}
pair_coeff      * * C
neighbor        ${skin} bin
neigh_modify    every 1 delay 0 check yes one 16000 page 160000
compute         pea all pe/atom
dump            d all custom 1 dump.${tag} id c_pea fx fy fz
dump_modify     d format float %.15g sort id
thermo_style    custom step pe press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %20.14g
run             0
